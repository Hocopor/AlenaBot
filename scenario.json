      "seconds": 10,
      "nextBlockId": "br1_end"
    },
    "br1_end": {
      "id": "br1_end",
      "type": "text",
      "text": "Надеюсь, он станет твоим маленьким другом \nЕсли почувствуешь, что хочется глубже — я рядом. В июне открываю живую группу «Перерождение». Напиши мне — поговорим подробнее.",
      "nextBlockId": "br1_end_b1"
    },
    "br1_end_b1": {

    "branch_2_audio": {
      "id": "branch_2_audio",
      "type": "text",
      "text": "<b>Аудио библиотека</b>\nВключай — и просто побудь. Ничего делать не нужно.\nЭто твои несколько минут только для тебя.",
      "nextBlockId": "br2_audio_file"
